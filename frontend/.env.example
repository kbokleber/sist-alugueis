VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="Controle de Aluguéis"
VITE_APP_VERSION=
# VITE_APP_BUILD_AT: definido automaticamente no vite.config (data/hora pt-BR ao compilar ou ao subir o dev server).

# Keycloak (realm familia, client alugueis — público)
VITE_KEYCLOAK_URL=https://auth.kbosolucoes.com.br
VITE_KEYCLOAK_REALM=familia
VITE_KEYCLOAK_CLIENT_ID=alugueis
